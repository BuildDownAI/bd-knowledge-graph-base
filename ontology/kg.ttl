@prefix kg:      <https://example.org/kg/onto#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:  <https://schema.org/> .

#################################################################
# AI-Implement Knowledge Graph — ontology (Phase 1)
# Two layers: spine (deterministic — git + GitHub + tracker) +
# semantic (parsed/extracted, always provenanced).
# Recreated for BuildDownAI/AI-Implement per the KG runbook §2.
#################################################################

kg: a owl:Ontology ;
    rdfs:label "AI-Implement Knowledge Graph ontology" ;
    owl:versionInfo "0.1.0" .

########################  SPINE CLASSES  ########################

kg:Repo         a owl:Class ; rdfs:label "Repository" .
kg:PullRequest  a owl:Class ; rdfs:label "Pull Request" .
kg:Commit       a owl:Class ; rdfs:label "Commit" .
kg:File         a owl:Class ; rdfs:label "File" .
kg:Doc          a owl:Class ; rdfs:label "Document" ; rdfs:subClassOf kg:File .
kg:Issue        a owl:Class ; rdfs:label "Tracker issue (Linear/Jira)" .
kg:Project      a owl:Class ; rdfs:label "Tracker project" .
kg:Person       a owl:Class ; rdfs:subClassOf foaf:Agent ; rdfs:label "Person" .
kg:BotAgent     a owl:Class ; rdfs:subClassOf kg:Person ; rdfs:label "Bot agent" .

# Doc-site spine (KGB-4): crawled documentation, never subclasses of SemanticNode
# so SemanticNodeShape provenance requirement never fires on these.
kg:DocSite      a owl:Class ; rdfs:label "Documentation site" .
kg:DocPage      a owl:Class ; rdfs:label "Documentation page" .
kg:DocSection   a owl:Class ; rdfs:label "Documentation section" .

# MCP-source spine (KGB-12): resources ingested from MCP servers.
kg:McpSource    a owl:Class ; rdfs:label "MCP source server" .

######################  SEMANTIC CLASSES  ######################

kg:Learning     a owl:Class ; rdfs:label "Learning" .
kg:Decision     a owl:Class ; rdfs:label "Decision" .
kg:Constraint   a owl:Class ; rdfs:label "Constraint" .
kg:FailureMode  a owl:Class ; rdfs:label "Failure mode" .
kg:Observation  a owl:Class ; rdfs:label "Observation (non-defect)" .
kg:Verification a owl:Class ; rdfs:label "Verification / gap-analysis record" .
kg:StatusUpdate a owl:Class ; rdfs:label "Status update event" .
kg:Topic        a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Topic (promoted tag)" .
# optional facets, added later on evidence (recon §4.4):
kg:Technology   a owl:Class ; rdfs:subClassOf kg:Topic .
kg:Pattern      a owl:Class ; rdfs:subClassOf kg:Topic .
kg:FailureClass a owl:Class ; rdfs:subClassOf kg:Topic .

kg:Chunk        a owl:Class ; rdfs:label "Retrieval chunk" .

# marker: the union of semantic node types that MUST carry provenance
kg:SemanticNode a owl:Class ; rdfs:label "Semantic node (provenance-required)" .
kg:Learning     rdfs:subClassOf kg:SemanticNode .
kg:Decision     rdfs:subClassOf kg:SemanticNode .
kg:Constraint   rdfs:subClassOf kg:SemanticNode .
kg:FailureMode  rdfs:subClassOf kg:SemanticNode .
kg:Observation  rdfs:subClassOf kg:SemanticNode .
kg:Verification  rdfs:subClassOf kg:SemanticNode .
kg:PlanningNote  a owl:Class ; rdfs:label "Planning note (orchestrator planning output)" .
kg:PlanningNote  rdfs:subClassOf kg:SemanticNode .
kg:ImplementationNote  a owl:Class ; rdfs:label "Implementation note (bot account of what a run implemented)" .
kg:ImplementationNote  rdfs:subClassOf kg:SemanticNode .

####################  PROVENANCE / VERSIONING  ####################

kg:ExtractionRun a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "Extraction run" .
kg:pipelineVer  a owl:DatatypeProperty ; rdfs:domain kg:ExtractionRun ; rdfs:range xsd:string .
kg:promptHash   a owl:DatatypeProperty ; rdfs:domain kg:ExtractionRun ; rdfs:range xsd:string .
kg:model        a owl:DatatypeProperty ; rdfs:domain kg:ExtractionRun ; rdfs:range xsd:string .
kg:notes        a owl:DatatypeProperty ; rdfs:domain kg:ExtractionRun ; rdfs:range xsd:string .

########################  SPINE PREDICATES  ########################

kg:partOf     a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "part of" ;
    schema:domainIncludes kg:Commit, kg:DocPage, kg:DocSection, kg:File, kg:Issue, kg:PullRequest ;
    schema:rangeIncludes  kg:DocPage, kg:DocSite, kg:Issue, kg:Repo .

# Not written by the ingest yet.
kg:touches    a owl:ObjectProperty ; rdfs:label "touches (file)" ;
    schema:rangeIncludes  kg:File .

kg:reviews    a owl:ObjectProperty ; rdfs:label "reviews" .

kg:references a owl:ObjectProperty ; rdfs:label "references" ;
    schema:domainIncludes kg:Commit, kg:PullRequest ;
    schema:rangeIncludes  kg:Issue .

kg:sourceSystem a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue, kg:Repo ;
    rdfs:range xsd:string .
kg:sourceId     a owl:DatatypeProperty ;
    schema:domainIncludes kg:Commit, kg:Repo ;
    rdfs:range xsd:string .
kg:contentHash  a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocPage ;
    rdfs:range xsd:string .
kg:uri          a owl:DatatypeProperty ; rdfs:range xsd:anyURI .
kg:path         a owl:DatatypeProperty ;
    schema:domainIncludes kg:File ;
    rdfs:range xsd:string .
kg:login        a owl:DatatypeProperty ;
    schema:domainIncludes kg:Person ;
    rdfs:range xsd:string .
kg:number       a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue, kg:PullRequest ;
    rdfs:range xsd:integer .
kg:state        a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue, kg:PullRequest ;
    rdfs:range xsd:string .

# Repository history metadata (KGB-42)
kg:historyBranch   a owl:DatatypeProperty ; rdfs:domain kg:Repo ; rdfs:range xsd:string .
kg:isDefaultBranch a owl:DatatypeProperty ; rdfs:domain kg:Repo ; rdfs:range xsd:boolean .
kg:snapshotRef     a owl:DatatypeProperty ; rdfs:domain kg:Repo ; rdfs:range xsd:string .

# Pull request extended metadata (KGB-42)
kg:baseRefName  a owl:DatatypeProperty ; rdfs:domain kg:PullRequest ; rdfs:range xsd:string .
kg:mergedAt     a owl:DatatypeProperty ; rdfs:domain kg:PullRequest ; rdfs:range xsd:dateTime .
kg:mergeCommit  a owl:ObjectProperty ; rdfs:domain kg:PullRequest ; rdfs:range kg:Commit .

# Doc-site spine predicates (KGB-4)
kg:docsUrl          a owl:DatatypeProperty ;
    schema:domainIncludes kg:Repo ;
    rdfs:range xsd:string .  # Repo -> documentation root URL
kg:rootUrl          a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSite ;
    rdfs:range xsd:string .  # DocSite root URL
kg:url              a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocPage ;
    rdfs:range xsd:string .  # DocPage full URL
kg:anchor           a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSection ;
    rdfs:range xsd:string .  # DocSection heading anchor slug
kg:heading          a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSection ;
    rdfs:range xsd:string .  # DocSection heading text
kg:level            a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSection ;
    rdfs:range xsd:integer . # DocSection heading level (1–4)
kg:documentsBranch  a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSite ;
    rdfs:range xsd:string .  # DocSite: code branch this docs version documents (KGB-5)
kg:mcpServer        a owl:DatatypeProperty ;
    schema:domainIncludes kg:McpSource ;
    rdfs:range xsd:string .  # McpSource server name/endpoint (KGB-12)

# --- tracker (Linear/Jira) spine ---
kg:trackerKey   a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue ;
    rdfs:range xsd:string .  # "AII-256"
kg:trackerTeam  a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue ;
    rdfs:range xsd:string .  # "AII"
kg:description  a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue ;
    rdfs:range xsd:string .
kg:label        a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue ;
    rdfs:range xsd:string .  # raw tracker label
kg:branchName   a owl:DatatypeProperty ;
    schema:domainIncludes kg:Issue ;
    rdfs:range xsd:string .
kg:inProject    a owl:ObjectProperty ;           # issue -> project
    schema:domainIncludes kg:Issue ;
    schema:rangeIncludes  kg:Project .
kg:relatedTo    a owl:ObjectProperty ;           # issue <-> issue (Linear "related")
    schema:domainIncludes kg:Issue ;
    schema:rangeIncludes  kg:Issue .
kg:addressedBy  a owl:ObjectProperty ;           # issue -> pr / commit (loop to code)
    schema:domainIncludes kg:Issue ;
    schema:rangeIncludes  kg:Commit, kg:PullRequest .

######################  SEMANTIC PREDICATES  ######################

# learning <-> learning / doc typed relations (recon §2.4 pre-built edge set)
kg:supersedes     a owl:ObjectProperty ; rdfs:label "supersedes" .
kg:supersededBy   a owl:ObjectProperty ; owl:inverseOf kg:supersedes .
kg:duplicateOf    a owl:ObjectProperty ;
    schema:domainIncludes kg:Issue ;
    schema:rangeIncludes  kg:Issue .
kg:recurrenceOf   a owl:ObjectProperty .
# Not written by the ingest yet.
kg:resolvedBy     a owl:ObjectProperty ;          # learning -> pr/commit
    schema:domainIncludes kg:Learning ;
    schema:rangeIncludes  kg:Commit, kg:PullRequest .
kg:regressedBy    a owl:ObjectProperty ;          # learning -> pr/commit
    schema:domainIncludes kg:Learning ;
    schema:rangeIncludes  kg:Commit, kg:PullRequest .
kg:filedAs        a owl:ObjectProperty ;          # learning -> issue/ticket
    schema:domainIncludes kg:Decision, kg:Learning ;
    schema:rangeIncludes  kg:Issue .
kg:relatedPr      a owl:ObjectProperty ;          # learning -> pr
    schema:domainIncludes kg:Learning ;
    schema:rangeIncludes  kg:PullRequest .
kg:relatedSolution a owl:ObjectProperty ;         # doc -> doc
    schema:domainIncludes kg:Learning ;
    schema:rangeIncludes  kg:Doc .
# Not written by the ingest yet.
kg:affectsFile    a owl:ObjectProperty ;          # learning -> file
    schema:domainIncludes kg:Learning ;
    schema:rangeIncludes  kg:File .
kg:affectsComponent a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .  # raw "file:func"
kg:tagged         a owl:ObjectProperty ; rdfs:label "tagged" ;        # node -> Topic
    schema:domainIncludes kg:Issue, kg:SemanticNode ;
    schema:rangeIncludes  kg:Topic .
kg:dependsOn      a owl:ObjectProperty ;          # issue -> issue (todo dependencies)
    schema:domainIncludes kg:Issue ;
    schema:rangeIncludes  kg:Issue .
kg:aboutLearning  a owl:ObjectProperty ;          # StatusUpdate -> Learning
    schema:domainIncludes kg:StatusUpdate ;
    schema:rangeIncludes  kg:Learning .

# learning scalar properties (normalized frontmatter core, recon §2.1)
kg:learningId  a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:status      a owl:DatatypeProperty ;
    schema:domainIncludes kg:Decision, kg:Issue, kg:Learning ;
    rdfs:range xsd:string .
kg:category    a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:priority    a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .   # P0..P3
kg:severityLevel a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string . # critical/high/medium/low
kg:symptom     a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:rootCause   a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:impact      a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:fix         a owl:DatatypeProperty ;
    schema:domainIncludes kg:SemanticNode ;
    rdfs:range xsd:string .
kg:foundDate   a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:date .
kg:problemType a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:resolutionType a owl:DatatypeProperty ;
    schema:domainIncludes kg:Learning ;
    rdfs:range xsd:string .
kg:detail      a owl:DatatypeProperty ;
    schema:domainIncludes kg:Doc, kg:DocPage, kg:SemanticNode ;
    rdfs:range xsd:string .  # long prose body (comment learnings)

# retrieval
kg:ofNode      a owl:ObjectProperty ; rdfs:domain kg:Chunk .
kg:ordinal     a owl:DatatypeProperty ; rdfs:domain kg:Chunk ; rdfs:range xsd:integer .
kg:text        a owl:DatatypeProperty ;
    schema:domainIncludes kg:DocSection ;
    rdfs:range xsd:string .
kg:confidence  a owl:DatatypeProperty ; rdfs:range xsd:decimal .  # RDF-star annotation on extracted edges

# PR review content properties (KGB-47) — used on kg:Verification nodes for inline
# review comments and review bodies from pulls/{n}/comments and pulls/{n}/reviews.
kg:reviewerLogin       a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:reviewerKind        a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:severity            a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:reviewFilePath      a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:reviewLine          a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:integer .
kg:commitId            a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:originalCommitId    a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:threadState         a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
kg:reviewState         a owl:DatatypeProperty ; rdfs:domain kg:Verification ; rdfs:range xsd:string .
